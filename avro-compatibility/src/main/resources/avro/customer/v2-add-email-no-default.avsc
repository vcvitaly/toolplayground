{
  "type": "record",
  "name": "Customer",
  "namespace": "io.github.vcvitaly.avro",
  "doc": "Adds a field without a default: forward compatible only.",
  "fields": [
    {
      "name": "id",
      "type": "int"
    },
    {
      "name": "name",
      "type": "string"
    },
    {
      "name": "tier",
      "type": {
        "type": "enum",
        "name": "Tier",
        "symbols": [
          "BASIC",
          "GOLD"
        ]
      }
    },
    {
      "name": "email",
      "type": "string"
    }
  ]
}
